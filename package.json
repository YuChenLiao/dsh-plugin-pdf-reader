{
  "name": "dsh-plugin-pdf-reader",
  "version": "0.0.1",
  "description": "DSH PDF 读取插件：给模型一个专用 PDF 工具，转换 + 质量量化 + 三档判定，正文按页读；fast / hybrid / fallback 三引擎可独立开关",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./fast": {
      "default": "./lib/fast.js"
    },
    "./hybrid": {
      "default": "./lib/hybrid.js"
    },
    "./fallback": {
      "default": "./lib/fallback.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pdf"
  ],
  "license": "MIT",
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@opendataloader/pdf": "2.5.20"
  }
}
